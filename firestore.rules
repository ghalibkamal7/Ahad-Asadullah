rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Collections that make up the public catalog: readable by anyone
    // (signed out visitors included, so marketing pages work), writable
    // only by an admin.
    function isPublicCatalogCollection(name) {
      return name in [
        'courses', 'testSeries', 'pdfs', 'videoLectures', 'notes',
        'practiceSets', 'previousPapers', 'currentAffairs', 'categories',
        'notifications'
      ];
    }

    // --- Users ---------------------------------------------------------
    // A user can read/create/update their own profile. Admins can read
    // and update any profile (needed for the "Make Admin" toggle).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Public catalog content ------------------------------------------
    match /{collectionId}/{docId} {
      allow read: if isPublicCatalogCollection(collectionId);
      allow write: if isPublicCatalogCollection(collectionId) && isAdmin();
    }

    // --- Coupons -----------------------------------------------------------
    // Signed-in users can read to validate a code at checkout. In
    // production, prefer verifying coupons from a Cloud Function so the
    // discount table is never fully exposed to the client.
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Orders --------------------------------------------------------------
    // A student can create an order for themself and read only their own
    // orders. Only admins can read every order or change order status.
    // NOTE: for production, create orders from a trusted Cloud Function
    // after verifying the Razorpay payment signature server-side —
    // this rule is a safe baseline for launch, not a replacement for that.
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
